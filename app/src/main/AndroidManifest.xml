<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Требуем OpenGL ES 3.0 на уровне оборудования -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- Разрешения НЕ нужны: файлы открываются через Storage Access Framework
         (ACTION_OPEN_DOCUMENT), который работает без READ_EXTERNAL_STORAGE. -->

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Открыть с помощью» для 3D-файлов.
                 */* + контент-схема: появляется для ЛЮБОГО файла
                 (в т.ч. когда менеджер посылает application/octet-stream
                 или нестандартные mime). Парсер сам определит формат. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="model/*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/vnd.ms-3mfdocument" />
                <data android:mimeType="model/gltf-binary" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>