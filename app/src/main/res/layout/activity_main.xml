<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_viewer">

    <!-- 3D сцена -->
    <android.opengl.GLSurfaceView
        android:id="@+id/glView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Верхний оверлей: заголовок + настройки + стат-чип -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3Dwiv"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Название файла (обновляется из MainActivity) -->
                <TextView
                    android:id="@+id/fileText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_tagline"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/btn_circle"
                android:contentDescription="@string/btn_settings"
                android:src="@drawable/ic_settings"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Статистика модели -->
        <TextView
            android:id="@+id/statsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/chip_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/stats_empty"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Плавающая вертикальная группа масштабирования (справа, по центру) -->
    <LinearLayout
        android:id="@+id/zoomCluster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/zoomUp"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_circle"
            android:contentDescription="@string/btn_zoom_in"
            android:padding="14dp"
            android:src="@drawable/ic_zoom_in" />

        <ImageButton
            android:id="@+id/zoomDown"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/btn_circle"
            android:contentDescription="@string/btn_zoom_out"
            android:padding="14dp"
            android:src="@drawable/ic_zoom_out" />
    </LinearLayout>

    <!-- Нижний оверлей: подсказка + панель управления -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/hintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/hint_gestures"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:padding="6dp">

            <ImageButton
                android:id="@+id/btnOpen"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_primary"
                android:contentDescription="@string/btn_open"
                android:padding="14dp"
                android:src="@drawable/ic_open" />

            <ImageButton
                android:id="@+id/btnFit"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_secondary"
                android:contentDescription="@string/btn_fit"
                android:padding="14dp"
                android:src="@drawable/ic_fit" />

            <ImageButton
                android:id="@+id/btnGrid"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_secondary"
                android:contentDescription="@string/btn_wire"
                android:padding="14dp"
                android:src="@drawable/ic_grid" />

            <ImageButton
                android:id="@+id/btnShot"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_secondary"
                android:contentDescription="@string/btn_shot"
                android:padding="14dp"
                android:src="@drawable/ic_shot" />
        </LinearLayout>
    </LinearLayout>

    <!-- Подложка панели настроек -->
    <View
        android:id="@+id/settingsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim"
        android:visibility="gone" />

    <!-- Панель настроек (bottom sheet) -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sec_view"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingBottom="6dp" />

                <!-- Фон -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/opt_background"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <Button
                        android:id="@+id/btnBgDark"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_primary"
                        android:text="@string/bg_dark"
                        android:textColor="@color/text_on_accent"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnBgLight"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_secondary"
                        android:text="@string/bg_light"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnBgGraphite"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_secondary"
                        android:text="@string/bg_graphite"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Свет -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_ambient"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/ambValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28%"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbAmbient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="28" />

                <!-- Угол обзора -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_fov"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/fovValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45°"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbFov"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="95"
                    android:progress="30" />

                <!-- Оси -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_axes"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/swAxes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/sec_quality"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_msaa"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <Button
                        android:id="@+id/btnMsaaOff"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_secondary"
                        android:text="@string/msaa_off"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnMsaa2"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_secondary"
                        android:text="@string/msaa_x2"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnMsaa4"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_secondary"
                        android:text="@string/msaa_x4"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/sec_interaction"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingBottom="6dp" />

                <!-- Чувствительность вращения -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_rot_sens"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/sensValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbSens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="200"
                    android:progress="100" />

                <!-- Автоподгонка -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_auto_fit"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/swAutoFit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCloseSettings"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/btn_primary"
                    android:text="@string/close"
                    android:textColor="@color/text_on_accent"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>